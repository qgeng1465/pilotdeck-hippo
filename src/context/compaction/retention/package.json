{
  "name": "hippo-retention",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verbatim-retention scoring policy for LLM agent context compaction.",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qgeng1465/pilotdeck-hippo.git",
    "directory": "src/context/compaction/retention"
  },
  "homepage": "https://github.com/qgeng1465/pilotdeck-hippo#readme",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
